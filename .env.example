# Public origin used for canonical URLs, sitemap, OG tags, JSON-LD.
# No trailing slash. Override per environment (preview/production).
NEXT_PUBLIC_SITE_URL=https://charmsoft.com

# Resend API key (https://resend.com) for the /api/contact route.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=davecharm16@gmail.com

# From-address for outbound contact emails. Must be a verified Resend sender.
CONTACT_FROM_EMAIL=CharmSoft <noreply@charmsoft.com>
